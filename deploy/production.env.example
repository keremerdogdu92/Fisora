POSTGRES_DB=fisora
POSTGRES_USER=fisora
POSTGRES_PASSWORD=change-me

FISORA_HTTP_PORT=80
FISORA_STORE_BACKEND=postgres
FISORA_AUTH_MODE=session_required
FISORA_AUTH_HEADER=X-Fisora-User-Id
FISORA_AUTH_PASSWORD_BOOTSTRAP_ENABLED=false
FISORA_SESSION_COOKIE_SECURE=true
FISORA_SESSION_COOKIE_SAMESITE=lax
FISORA_CORS_ALLOW_ORIGINS=
FISORA_RATE_LIMIT_ENABLED=true
FISORA_RATE_LIMIT_WINDOW_SECONDS=60
FISORA_RATE_LIMIT_AI_MAX_REQUESTS=120
FISORA_RATE_LIMIT_EXPORT_MAX_REQUESTS=60
FISORA_DOCUMENT_STORAGE_BACKEND=local
FISORA_BACKUP_PATH=/opt/fisora/data/backups
FISORA_AI_PROVIDER=groq
FISORA_AI_MODEL=openai/gpt-oss-20b
FISORA_AI_COMPARISON_MODEL=openai/gpt-oss-120b
FISORA_AI_MONTHLY_CAP_USD=0.01
GROQ_API_KEY=
OPENAI_API_KEY=
FISORA_WORKER_RETENTION_INTERVAL_SECONDS=86400
FISORA_WORKER_PROCESSING_INTERVAL_SECONDS=30
FISORA_BACKUP_INTERVAL_SECONDS=86400
NEXT_PUBLIC_FISORA_API_BASE_URL=/api
